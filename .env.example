# --- Data API (primary is the default; swap to the alternative by changing this value) ---
NEXT_PUBLIC_BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
# Used automatically if the primary API is unreachable
NEXT_PUBLIC_BAZARDOR_FALLBACK_API_URL=https://api.abcz.workers.dev/api/bazardor

# --- Better Auth ---
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Your site origin. Local: http://localhost:3000  Vercel: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB (include the database name in the URI, e.g. .../bazardor) ---
MONGODB_URI=

# --- OAuth (optional until you register the apps) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
